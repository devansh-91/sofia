# Copy to .env and fill in. Never commit .env.

# LLM — local Ollama (no API key, nothing leaves the laptop)
OLLAMA_HOST=http://127.0.0.1:11434
# `sofia` is built from models/Sofia.Modelfile (HauhauCS Qwen3.5-4B-Uncensored, Q4_K_M)
SOFIA_MODEL=sofia
# Where the weights come from; scripts/sofia.sh builds `sofia-base` from it without the vision projector
SOFIA_SOURCE_MODEL=hf.co/HauhauCS/Qwen3.5-4B-Uncensored-HauhauCS-Aggressive:Q4_K_M
# Weights used for the memory-extraction prompts (same model, without the persona)
SOFIA_BASE_MODEL=sofia-base
# Where Sofia keeps what she has learned about you (default shown)
SOFIA_MEMORY=~/.local/share/sofia/memory.json
# Every exchange, kept for fine-tuning later (default shown)
SOFIA_LOG=~/.local/share/sofia/conversations.jsonl

# --- Voice (./scripts/sofia.sh setup) ---
# Speech to text: tiny / base / small / medium (bigger = better Hinglish, slower)
SOFIA_STT_MODEL=small
# Speech emotion recognition model (Hugging Face id)
SOFIA_SER_MODEL=superb/wav2vec2-base-superb-er
# turbo = Chatterbox-Turbo on the GPU (can laugh; falls back to Kokoro), kokoro = Kokoro on the CPU only
SOFIA_TTS=turbo
# A Kokoro voice (af_heart, af_bella, bf_emma, ...), which Turbo speaks a clone of; turbo = Turbo's own voice
SOFIA_VOICE=af_heart
SOFIA_VOICE_DIR=~/.local/share/sofia/voices
SOFIA_TURBO_VENV=~/.local/share/sofia/chatterbox
# Access key for the web app (created on first start)
SOFIA_KEY_FILE=~/.local/share/sofia/access-key
